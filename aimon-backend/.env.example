# AI-MON Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Gemini API (via Google AI Studio - aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
AI_LITELLM_DEFAULT_MODEL=gemini-2.5-flash

# LiteLLM Proxy
LITELLM_MASTER_KEY=sk-aimon-litellm-master-key

# Google Cloud Credentials (for STT/TTS)
GOOGLE_CREDENTIALS_FILE=./google-credentials.json

# PowerMem Memory Service
POWERMEM_API_KEY=dev-powermem-api-key

# VieNeu TTS
AI_VIENEU_TTS_ENABLED=true

# Database
DB_USER=aimon
DB_PASSWORD=aimon
